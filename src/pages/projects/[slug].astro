---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnnotatedMedia from '../../components/AnnotatedMedia.astro';
import CaseStudyTimeline from '../../components/CaseStudyTimeline.astro';
import LinkButton from '../../components/LinkButton.astro';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const caseStudies = await getCollection('caseStudies');

  return caseStudies.map((caseStudy) => {
    const project = projects.find((entry) => entry.data.slug === caseStudy.data.project);

    if (!project) {
      throw new Error(`Missing project entry for case study "${caseStudy.id}"`);
    }

    return {
      params: { slug: project.data.slug },
      props: { project: project.data, caseStudy: caseStudy.data }
    };
  });
}

const { project, caseStudy } = Astro.props;
type Fact = { label: string; value: string; group?: string };
type FactGroup = { group: string; facts: Fact[] };

const customFactGroups = Object.entries(
  caseStudy.facts.reduce<Record<string, Fact[]>>((groups, fact: Fact) => {
    const group = fact.group ?? 'Details';
    groups[group] = [...(groups[group] ?? []), fact];
    return groups;
  }, {})
).map(([group, facts]) => ({ group, facts }));

const factGroups = [
  {
    group: 'Project',
    facts: [
      { label: 'Project', value: project.title },
      { label: 'Role', value: project.role },
      { label: 'Status', value: project.status }
    ]
  },
  ...customFactGroups
] satisfies FactGroup[];
---

<BaseLayout title={`${project.title} - Malte Schümann`} description={project.summary}>
  <section class="case-hero section">
    <div class="case-copy">
      <p class="section-kicker">{caseStudy.eyebrow}</p>
      <h1>{caseStudy.headline}</h1>
      <p>{caseStudy.intro}</p>
      <TagList tags={project.tags} />
      <div class="link-row">
        {project.links.map((link) => <LinkButton href={link.href} label={link.label} />)}
      </div>
    </div>
    <AnnotatedMedia media={caseStudy.hero} />
  </section>

  <section class="section facts-section">
    <div class="facts">
      {factGroups.map((group) => (
        <article>
          <h2>{group.group}</h2>
          <dl>
            {group.facts.map((fact) => (
              <>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </section>

  {caseStudy.closing.length > 0 && (
    <section class="section project-note">
      <p class="section-kicker">Project note</p>
      {caseStudy.closing.map((paragraph) => <p>{paragraph}</p>)}
    </section>
  )}

  <section class="section process-section">
    <div class="section-header">
      <div>
        <p class="section-kicker">Process timeline</p>
        <h2 class="section-title">Process</h2>
      </div>
    </div>
    <CaseStudyTimeline items={caseStudy.timeline} />
  </section>

</BaseLayout>

<style>
  .case-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 36px;
    align-items: center;
    padding-top: 52px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 4.8vw, 4.8rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .case-copy > p:not(.section-kicker) {
    margin: 20px 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .facts-section {
    padding-top: 52px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .facts article {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    padding: 18px;
  }

  .facts h2 {
    margin: 0 0 14px;
    color: var(--text);
    font-size: 1rem;
  }

  .facts dl {
    display: grid;
    grid-template-columns: minmax(92px, 0.7fr) minmax(0, 1.3fr);
    gap: 10px 14px;
    margin: 0;
  }

  .facts dt {
    color: var(--subtle);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    font-weight: 750;
  }

  .project-note {
    padding-top: 52px;
  }

  .project-note p:not(.section-kicker) {
    max-width: 820px;
    margin: 0;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    color: var(--muted);
    font-size: 1.12rem;
  }

  .process-section {
    padding-bottom: 96px;
  }

  @media (max-width: 900px) {
    .case-hero,
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
