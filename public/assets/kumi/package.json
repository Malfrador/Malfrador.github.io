{
  "name": "kumi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:all": "concurrently -n api,web,solver -c cyan,magenta,green \"bun run dev:api\" \"bun run dev:web\" \"bun run dev:solver\"",
    "dev:api": "bun --filter @kumi/api dev",
    "dev:web": "bun --filter @kumi/web dev",
    "dev:solver": "bun run scripts/solver-run.ts",
    "solver:setup": "bun run scripts/solver-setup.ts",
    "build": "bun run --filter '@kumi/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:create": "bun run scripts/create-db.ts",
    "db:generate": "bun --filter @kumi/db generate",
    "db:migrate": "bun --filter @kumi/db migrate",
    "db:push": "bun --filter @kumi/db push",
    "db:seed": "bun --filter @kumi/db seed",
    "db:studio": "bun --filter @kumi/db studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.1.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
